# =====================================================================
#  Préstalo — Variables de entorno (plantilla)
#  Copiar a .env y completar. NUNCA subir el .env real al repositorio.
# =====================================================================

# --- Núcleo ---
PORT=3000
NODE_ENV=production

# --- Base de datos ---
# Producción (Supabase): URL del pooler, SSL activado (no definir DB_SSL o =true)
# Base interna del clúster: definir DB_SSL=false
DATABASE_URL=postgres://usuario:clave@host:5432/prestalo_db
DB_SSL=false
PG_POOL_MAX=3

# Solo para docker-compose local
DB_PASSWORD=cambia_esta_clave

# --- Seguridad ---
# Clave para firmar los tokens de sesión (usar un valor largo y aleatorio)
PRESTALO_SECRET=cambia_este_secreto_largo

# --- Tareas programadas ---
# En réplicas web con CronJob externo, poner true para no duplicar la rutina no-show
DISABLE_CRON=false

# --- Opcionales ---
PUBLIC_URL=https://prestalo.ust.cl
# ANTHROPIC_API_KEY=            # asistente IA (si se reactiva)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Préstalo <no-reply@ust.cl>
